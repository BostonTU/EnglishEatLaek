<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pixel_bg"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Score Header -->
        <LinearLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="10dp"
            android:background="@drawable/pixel_panel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/score_initial"
                android:textColor="@color/px_text"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="22sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="18sp" />

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvCombo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/combo_initial"
                android:textColor="@color/px_combo"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="22sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="18sp" />

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvHighScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/best_initial"
                android:textColor="@color/px_score"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="22sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="18sp" />
        </LinearLayout>

        <!-- Timer -->
        <LinearLayout
            android:id="@+id/layoutTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/progressBarTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/pixel_progress"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progress="100" />

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvTimer"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="@string/timer_initial"
                android:textColor="@color/px_timer"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="end" />
        </LinearLayout>

        <!-- Vocabulary Card -->
        <LinearLayout
            android:id="@+id/layoutWordCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/pixel_panel"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp"
            android:gravity="center"
            android:elevation="3dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTimer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                tools:text="LEVEL: EASY"
                android:textColor="@color/px_dim"
                android:textSize="16sp"
                android:maxLines="1"
                android:gravity="center" />

            <com.example.englisheatleak.OutlineTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/question_instruction"
                android:textColor="@color/px_dim"
                android:textSize="18sp"
                android:gravity="center" />

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                tools:text="Vocabulary"
                android:textColor="@color/px_text"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="40sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="40sp" />
        </LinearLayout>

        <!-- Character Shadow -->
        <View
            android:id="@+id/shadowView"
            android:layout_width="90dp"
            android:layout_height="16dp"
            android:background="@drawable/shadow_oval"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Character -->
        <ImageView
            android:id="@+id/characterView"
            android:layout_width="200dp"
            android:layout_height="230dp"
            android:contentDescription="@string/game_character_content_description"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toBottomOf="@id/layoutWordCard"
            app:layout_constraintBottom_toTopOf="@id/tvFatStatus"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Character Status -->
        <com.example.englisheatleak.OutlineTextView
            android:id="@+id/tvFatStatus"
            android:background="@drawable/pixel_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/fat_status_0"
            android:textColor="@color/px_text"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="24sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="24sp"
            app:layout_constraintBottom_toTopOf="@id/layoutChoices"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="360dp" />

        <!-- Answer Buttons -->
        <LinearLayout
            android:id="@+id/layoutChoices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.example.englisheatleak.OutlineButton
                android:id="@+id/btnChoice1"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/choice_1"
                android:background="@drawable/pixel_btn_choice"
                app:backgroundTint="@null"
                android:textColor="@color/px_text"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="26sp" />

            <com.example.englisheatleak.OutlineButton
                android:id="@+id/btnChoice2"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/choice_2"
                android:background="@drawable/pixel_btn_choice"
                app:backgroundTint="@null"
                android:textColor="@color/px_text"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="26sp" />
        </LinearLayout>

        <!-- Game Over -->
        <LinearLayout
            android:id="@+id/layoutGameOver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/pixel_panel"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layoutWordCard"
            app:layout_constraintBottom_toTopOf="@id/layoutChoices"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvGameOverTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAME OVER!"
                android:textColor="@color/px_timer"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="40sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="22sp"
                android:autoSizeMaxTextSize="40sp" />

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvGameOverReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="คำตอบที่ถูกคือ..."
                android:textColor="@color/px_text"
                android:textSize="26sp"
                android:gravity="center" />

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvFinalStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Words: 0"
                android:textColor="@color/px_dim"
                android:textSize="18sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="18dp">

                <com.example.englisheatleak.OutlineButton
                    android:id="@+id/btnRestart"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="@string/btn_play_again"
                    android:background="@drawable/pixel_btn_green"
                    app:backgroundTint="@null"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="24sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="24sp" />

                <com.example.englisheatleak.OutlineButton
                    android:id="@+id/btnGameOverMenu"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="@string/btn_main_menu"
                    android:background="@drawable/pixel_btn_gray"
                    app:backgroundTint="@null"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="24sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="24sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pause Overlay -->
    <LinearLayout
        android:id="@+id/layoutPauseOverlay"
        android:elevation="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:background="#D9000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.example.englisheatleak.OutlineTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="พักเกมอยู่ (PAUSED)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="40sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="40sp" />

        <com.example.englisheatleak.OutlineTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="แตะปุ่มเพื่อเล่นเกมต่อจากเวลาที่เหลืออยู่"
            android:textColor="@color/px_dim"
            android:gravity="center"
            android:textSize="24sp" />

        <com.example.englisheatleak.OutlineButton
            android:id="@+id/btnResumeGame"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="@string/btn_resume"
            android:background="@drawable/pixel_btn_green"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="26sp" />

        <com.example.englisheatleak.OutlineButton
            android:id="@+id/btnPauseQuitMenu"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="@string/btn_back_to_main"
            android:background="@drawable/pixel_btn_red"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="26sp" />
    </LinearLayout>

    <!-- Start Screen: จัดทั้งกลุ่ม (ชื่อเกม + คำโปรย + เมนู) ให้อยู่กลางจอ -->
    <LinearLayout
        android:id="@+id/layoutStartScreen"
        android:elevation="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="48dp"
        android:background="@drawable/start_bg"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <!-- กรอบชื่อเกม (สไตล์เดียวกับกรอบเมนู) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/pixel_panel"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <com.example.englisheatleak.OutlineTextView
                android:id="@+id/tvAppTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_english"
                android:textColor="@color/px_text"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textSize="30sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="30sp"
                app:pixelShadowColor="@color/px_outline"
                app:pixelShadowDx="3dp"
                app:pixelShadowDy="3dp" />

            <com.example.englisheatleak.OutlineTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_eat_laek"
                android:textColor="@color/px_score"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textSize="48sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="48sp"
                app:pixelShadowColor="@color/px_outline"
                app:pixelShadowDx="4dp"
                app:pixelShadowDy="4dp" />
        </LinearLayout>

        <com.example.englisheatleak.OutlineTextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/px_text"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="24sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pixel_panel"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp"
                android:clipChildren="false"
                app:layout_constraintWidth_max="340dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.example.englisheatleak.OutlineTextView
                    android:id="@+id/tvStartHighScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/start_high_score_initial"
                    android:textColor="@color/px_score"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textSize="22sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/imgMenuArrow"
                        android:layout_width="16dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_menu_arrow"
                        android:importantForAccessibility="no" />

                    <com.example.englisheatleak.OutlineButton
                        android:id="@+id/btnStartGame"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="0dp"
                        android:text="@string/btn_start_game"
                        android:background="@drawable/pixel_menu_row"
                        app:backgroundTint="@null"
                        app:strokeWidth="0dp"
                        android:textColor="@color/px_text"
                        android:textAllCaps="false"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:textSize="30sp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="30sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/px_ink" />

                <com.example.englisheatleak.OutlineButton
                    android:id="@+id/btnSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="0dp"
                    android:text="@string/btn_settings"
                    android:background="@drawable/pixel_menu_row"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp"
                    android:textColor="@color/px_text"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:textSize="30sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="30sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/px_ink" />

                <com.example.englisheatleak.OutlineButton
                    android:id="@+id/btnResetHighScore"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="0dp"
                    android:text="@string/btn_reset_high_score"
                    android:background="@drawable/pixel_menu_row"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp"
                    android:textColor="@color/px_red_text"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:textSize="30sp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="30sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


    <!-- Difficulty Selection Screen -->
    <LinearLayout
        android:id="@+id/layoutDifficultyScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/pixel_bg"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/pixel_panel"
                    android:padding="24dp">

                    <com.example.englisheatleak.OutlineTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/difficulty_title"
                        android:textColor="@color/px_text"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingBottom="8dp" />

                    <com.example.englisheatleak.OutlineTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/difficulty_description"
                        android:textColor="@color/px_dim"
                        android:textSize="16sp"
                        android:gravity="center"
