<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/color_background"
    tools:context=".MainActivity">

    <!-- Score Header -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/color_surface"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Score: 0"
            android:textColor="@color/color_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvCombo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Combo: 0 🔥"
            android:textColor="@color/color_danger"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Best: 0 🏆"
            android:textColor="@color/color_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Timer -->
    <LinearLayout
        android:id="@+id/layoutTimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBarTimer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/color_primary"
            android:progressBackgroundTint="@color/color_surface_alt"/>

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="10s"
            android:textColor="@color/color_danger"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Vocabulary Card -->
    <LinearLayout
        android:id="@+id/layoutWordCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="@color/color_surface"
        android:padding="18dp"
        android:gravity="center"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL: EASY"
            android:textColor="@color/color_secondary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vocabulary"
            android:textColor="@color/color_text"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Character Shadow -->
    <View
        android:id="@+id/shadowView"
        android:layout_width="90dp"
        android:layout_height="16dp"
        android:background="@drawable/shadow_oval"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Character -->
    <ImageView
        android:id="@+id/characterView"
        android:layout_width="200dp"
        android:layout_height="230dp"
        android:contentDescription="Game Character"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@id/layoutWordCard"
        app:layout_constraintBottom_toTopOf="@id/tvFatStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Character Status -->
    <TextView
        android:id="@+id/tvFatStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="ร่างตัวละคร: ปกติ (Fat Lv.0)"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toTopOf="@id/layoutChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Answer Buttons -->
    <LinearLayout
        android:id="@+id/layoutChoices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChoice1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="ตัวเลือก 1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_primary"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnChoice2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="ตัวเลือก 2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_secondary"
            android:textColor="@color/color_text"/>
    </LinearLayout>

    <!-- Game Over -->
    <LinearLayout
        android:id="@+id/layoutGameOver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@color/color_surface"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutWordCard"
        app:layout_constraintBottom_toTopOf="@id/layoutChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvGameOverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER!"
            android:textColor="@color/color_danger"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvGameOverReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="คำตอบที่ถูกคือ..."
            android:textColor="@color/color_text"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvFinalStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Final Score: 0"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="เล่นอีกครั้ง"
                android:backgroundTint="@color/color_primary"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnGameOverMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="หน้าหลัก"
                android:backgroundTint="@color/color_text_secondary"
                android:textColor="@color/white"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Pause Overlay -->
    <LinearLayout
        android:id="@+id/layoutPauseOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D9000000"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="พักเกมอยู่ (PAUSED) ⏸️"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="แตะปุ่มเพื่อเล่นเกมต่อจากเวลาที่เหลืออยู่"
            android:textColor="#CCCCCC"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnResumeGame"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="เล่นเกมต่อ"
            android:backgroundTint="@color/color_primary"
            android:textColor="@color/white"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnPauseQuitMenu"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="กลับหน้าหลัก"
            android:backgroundTint="@color/color_danger"
            android:textColor="@color/white"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Start Screen -->
    <LinearLayout
        android:id="@+id/layoutStartScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@color/color_background"
        android:elevation="16dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English Eat Laek"
            android:textColor="@color/color_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="เกมทายคำศัพท์ภาษาอังกฤษ กินเพื่อเติบโต! 🍔"
            android:textColor="@color/color_text_secondary"
            android:textSize="15sp"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/imgStartCharacter"
            android:layout_width="180dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/character_idle"
            android:contentDescription="Start Character"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/tvStartHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="คะแนนสูงสุด: 0 🏆"
            android:textColor="@color/color_accent"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="เริ่มเล่นเกม (Start)"
            android:backgroundTint="@color/color_primary"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_settings"
            android:backgroundTint="@color/color_secondary"
            android:textColor="@color/color_text"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnResetHighScore"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="ลบสถิติคะแนนสูงสุด"
            android:backgroundTint="@color/color_danger"
            android:textColor="@color/white"
            android:textSize="14sp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
