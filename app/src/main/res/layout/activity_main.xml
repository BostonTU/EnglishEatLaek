<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- แถบแสดงคะแนนและคอมโบ -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score: 0 | Combo: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- กรอบคำศัพท์ภาษาอังกฤษ -->
    <TextView
        android:id="@+id/tvWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#F0F0F0"
        android:gravity="center"
        android:padding="16dp"
        android:text="Vocabulary"
        android:textColor="#222222"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- เงาใต้ตัวละคร -->
    <View
        android:id="@+id/shadowView"
        android:layout_width="90dp"
        android:layout_height="16dp"
        android:background="@drawable/shadow_oval"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ตัวละคร -->
    <ImageView
        android:id="@+id/characterView"
        android:layout_width="200dp"
        android:layout_height="250dp"
        android:contentDescription="Game Character"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@id/tvWord"
        app:layout_constraintBottom_toTopOf="@id/layoutChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ปุ่มเริ่มใหม่ (โผล่เฉพาะตอนตอบผิด/ตัวละครตาย) -->
    <Button
        android:id="@+id/btnRestart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="เล่นอีกครั้ง (Restart)"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ปุ่มตัวเลือกภาษาไทย 2 ปุ่ม -->
    <LinearLayout
        android:id="@+id/layoutChoices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChoice1"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="ตัวเลือก 1"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnChoice2"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="ตัวเลือก 2"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>