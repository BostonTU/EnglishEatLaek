<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/pixel_bg"
    tools:context=".MainActivity">

    <!-- Score Header -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="10dp"
        android:background="@drawable/pixel_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvScore"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Words: 0"
            android:textColor="@color/px_text"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp" />

        <TextView
            android:id="@+id/tvCombo"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Combo: 0 🔥"
            android:textColor="@color/px_combo"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp" />

        <TextView
            android:id="@+id/tvHighScore"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Best: 0 🏆"
            android:textColor="@color/px_score"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="10sp" />
    </LinearLayout>

    <!-- Timer -->
    <LinearLayout
        android:id="@+id/layoutTimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBarTimer"
            style="?android:attr/progressBarStyleHorizontal"
            android:progressDrawable="@drawable/pixel_progress"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progress="100" />

        <TextView
            android:id="@+id/tvTimer"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="10s"
            android:textColor="@color/px_timer"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:gravity="end" />
    </LinearLayout>

    <!-- Vocabulary Card -->
    <LinearLayout
        android:id="@+id/layoutWordCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/pixel_panel"
        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp"
        android:gravity="center"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDifficulty"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            tools:text="LEVEL: EASY"
            android:textColor="@color/px_dim"
            android:textSize="9sp"
            android:maxLines="1"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvWord"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            tools:text="Vocabulary"
            android:textColor="@color/px_text"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="22sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="22sp" />
    </LinearLayout>

    <!-- Character Shadow -->
    <View
        android:id="@+id/shadowView"
        android:layout_width="90dp"
        android:layout_height="16dp"
        android:background="@drawable/shadow_oval"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Character -->
    <ImageView
        android:id="@+id/characterView"
        android:layout_width="200dp"
        android:layout_height="230dp"
        android:contentDescription="Game Character"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@id/layoutWordCard"
        app:layout_constraintBottom_toTopOf="@id/tvFatStatus"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Character Status -->
    <TextView
        android:id="@+id/tvFatStatus"
        android:fontFamily="@font/tagbamonothai"
        android:background="@drawable/pixel_panel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="ร่างตัวละคร: ปกติ (Fat Lv.0)"
        android:textColor="@color/px_text"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="24sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="24sp"
        app:layout_constraintBottom_toTopOf="@id/layoutChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="360dp" />

    <!-- Answer Buttons -->
    <LinearLayout
        android:id="@+id/layoutChoices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChoice1"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="ตัวเลือก 1"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="26sp" />

        <Button
            android:id="@+id/btnChoice2"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="ตัวเลือก 2"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="26sp" />
    </LinearLayout>

    <!-- Game Over -->
    <LinearLayout
        android:id="@+id/layoutGameOver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="@drawable/pixel_panel"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutWordCard"
        app:layout_constraintBottom_toTopOf="@id/layoutChoices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvGameOverTitle"
            android:fontFamily="@font/press_start_2p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAME OVER!"
            android:textColor="@color/px_timer"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="16sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp" />

        <TextView
            android:id="@+id/tvGameOverReason"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="คำตอบที่ถูกคือ..."
            android:textColor="@color/px_text"
            android:textSize="26sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvFinalStats"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Words: 0"
            android:textColor="@color/px_dim"
            android:textSize="14sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnRestart"
                android:fontFamily="@font/tagbamonothai"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="เล่นอีกครั้ง"
                android:backgroundTint="@color/px_green"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="24sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp" />

            <Button
                android:id="@+id/btnGameOverMenu"
                android:fontFamily="@font/tagbamonothai"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="หน้าหลัก"
                android:backgroundTint="#566C86"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="24sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pause Overlay -->
    <LinearLayout
        android:id="@+id/layoutPauseOverlay"
        android:elevation="10dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:background="#D9000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="พักเกมอยู่ (PAUSED) ⏸️"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="40sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="40sp" />

        <TextView
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="แตะปุ่มเพื่อเล่นเกมต่อจากเวลาที่เหลืออยู่"
            android:textColor="@color/px_dim"
            android:gravity="center"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnResumeGame"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="เล่นเกมต่อ"
            android:backgroundTint="@color/px_green"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="26sp" />

        <Button
            android:id="@+id/btnPauseQuitMenu"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="กลับหน้าหลัก"
            android:backgroundTint="@color/px_red"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="26sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="26sp" />
    </LinearLayout>

    <!-- Start Screen -->
    <!-- ===================== START SCREEN =====================
         ซ้อนจากบนลงล่าง: แผงชื่อเกม -> ตัวละคร (พื้นที่ยืดได้) -> คะแนน -> ปุ่ม
         paddingBottom 92dp เว้นให้ปุ่มอยู่เหนือพื้นหญ้าของพื้นหลัง (หญ้าสูง 76dp) -->
    <LinearLayout
        android:id="@+id/layoutStartScreen"
        android:elevation="10dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="108dp"
        android:paddingBottom="92dp"
        android:background="@drawable/start_bg"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- แผงชื่อเกม -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/pixel_panel"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:fontFamily="@font/press_start_2p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="English Eat Laek"
                android:textColor="@color/px_text"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="20sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="20sp" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:fontFamily="@font/tagbamonothai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="เกมทายคำศัพท์ภาษาอังกฤษ กินเพื่อเติบโต! 🍔"
                android:textColor="@color/px_dim"
                android:gravity="center"
                android:maxLines="2"
                android:textSize="22sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="22sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:layout_width="104dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:layout_marginTop="70dp"
                android:background="@drawable/shadow_oval" />

            <ImageView
                android:id="@+id/imgStartCharacter"
                android:layout_width="171dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/character_idle"
                android:contentDescription="Start Character"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- คะแนนสูงสุด -->
        <TextView
            android:id="@+id/tvStartHighScore"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@drawable/pixel_panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="คะแนนสูงสุด: 0 🏆"
            android:textColor="@color/px_combo"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="28sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="30sp" />

        <!-- ปุ่มเริ่มเล่น (ปุ่มหลัก ใหญ่สุด) -->
        <Button
            android:id="@+id/btnStartGame"
            android:fontFamily="@font/tagbamonothai"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="เริ่มเล่นเกม (Start)"
            android:backgroundTint="@color/px_green"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="30sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="32sp" />

        <!-- ปุ่มรอง 2 ปุ่มเรียงข้างกัน -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSettings"
                android:fontFamily="@font/tagbamonothai"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="@string/btn_settings"
                android:backgroundTint="@color/px_blue"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnResetHighScore"
                android:fontFamily="@font/tagbamonothai"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="ลบสถิติ"
                android:backgroundTint="@color/px_red"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>