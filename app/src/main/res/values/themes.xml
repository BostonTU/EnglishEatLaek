<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.EnglishEatLeak" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/px_bg</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textViewStyle">@style/Pixel.Text</item>
        <item name="materialButtonStyle">@style/Pixel.Button</item>
        <item name="colorPrimary">@color/px_blue</item>
        <item name="colorOnPrimary">@color/px_text</item>
        <item name="android:statusBarColor">@color/px_ink</item>
    </style>

    <style name="Theme.EnglishEatLeak" parent="Base.Theme.EnglishEatLeak" />

    <style name="Pixel.Text" parent="android:Widget.TextView">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pixel.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">4dp</item>
        <item name="strokeColor">@color/px_ink</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>