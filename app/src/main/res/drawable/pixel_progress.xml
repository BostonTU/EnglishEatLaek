<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item><shape><solid android:color="@color/px_ink"/><stroke android:width="2dp" android:color="@color/px_text"/></shape></item>
            <!-- เงาด้านในหลอด (จม) -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:gravity="top" android:height="3dp">
                <shape><solid android:color="#40000000"/></shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item><shape><solid android:color="@color/px_yellow"/></shape></item>
                <!-- แสงด้านบน / เงาด้านล่างของแท่ง -->
                <item android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
                <item android:gravity="bottom" android:height="3dp"><shape><solid android:color="#33000000"/></shape></item>
            </layer-list>
        </clip>
    </item>
</layer-list>