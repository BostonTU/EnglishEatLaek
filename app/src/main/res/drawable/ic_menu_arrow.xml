<?xml version="1.0" encoding="utf-8"?>
<!-- ลูกศรเมนู pixel + เงา (เงาเยื้องลงขวา 1 พิกเซล) + ไฮไลต์มุมบนซ้าย ช่องละ 4dp -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="24dp"
    android:viewportWidth="4"
    android:viewportHeight="6">
    <!-- เงา -->
    <path
        android:fillColor="@color/px_outline"
        android:fillAlpha="0.65"
        android:pathData="M1,1h1v1h-1z M1,2h2v1h-2z M1,3h3v1h-3z M1,4h2v1h-2z M1,5h1v1h-1z" />
    <!-- ตัวลูกศร -->
    <path
        android:fillColor="@color/px_combo"
        android:pathData="M0,0h1v1h-1z M0,1h2v1h-2z M0,2h3v1h-3z M0,3h2v1h-2z M0,4h1v1h-1z" />
    <!-- แสงมุมบนซ้าย -->
    <path
        android:fillColor="#66FFFFFF"
        android:pathData="M0,0h1v1h-1z M0,1h1v1h-1z" />
</vector>