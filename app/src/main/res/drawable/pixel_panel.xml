<?xml version="1.0" encoding="utf-8"?>
<!-- แผง pixel + แสงเงา: ขอบสว่างด้านบน/ซ้าย ขอบเงาด้านล่าง/ขวา (สีโปร่งใส ใช้ได้ทั้งสองธีม) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
    <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape><solid android:color="@color/px_panel"/></shape>
    </item>
    <!-- แสง: บน + ซ้าย -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:gravity="top" android:height="4dp">
        <shape><solid android:color="#40FFFFFF"/></shape>
    </item>
    <item android:left="4dp" android:top="8dp" android:bottom="8dp" android:gravity="left" android:width="4dp">
        <shape><solid android:color="#26FFFFFF"/></shape>
    </item>
    <!-- เงา: ล่าง + ขวา -->
    <item android:left="4dp" android:right="4dp" android:bottom="4dp" android:gravity="bottom" android:height="6dp">
        <shape><solid android:color="#2E000000"/></shape>
    </item>
    <item android:right="4dp" android:top="8dp" android:bottom="10dp" android:gravity="right" android:width="4dp">
        <shape><solid android:color="#1F000000"/></shape>
    </item>
</layer-list>