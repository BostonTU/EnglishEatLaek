<?xml version="1.0" encoding="utf-8"?>
<!-- ปุ่มเลื่อนสวิตช์ pixel: สูงกว่ารางเล็กน้อย มีแสงเงา จุดเขียว=เปิด จุดเทา=ปิด -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel_pressed"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="4dp" android:right="4dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#33000000"/></shape></item>
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"><shape><solid android:color="@color/px_green"/></shape></item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="4dp" android:right="4dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#33000000"/></shape></item>
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"><shape><solid android:color="@color/px_green"/></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel_pressed"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="4dp" android:right="4dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#33000000"/></shape></item>
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"><shape><solid android:color="@color/px_dim"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="4dp" android:right="4dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#33000000"/></shape></item>
            <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"><shape><solid android:color="@color/px_dim"/></shape></item>
        </layer-list>
    </item>
</selector>