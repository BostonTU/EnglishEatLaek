<?xml version="1.0" encoding="utf-8"?>
<!-- Radio แบบ pixel: วงกลมมุมตัด + แสงเงา ติ๊กแล้วมีจุดเขียว กดแล้วพื้นเข้มขึ้น -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel_pressed"/></shape></item>
            <item android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp"><shape><solid android:color="@color/px_panel_pressed"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="8dp" android:right="8dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#26000000"/></shape></item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"><shape><solid android:color="@color/px_green"/></shape></item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="8dp" android:right="8dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#26000000"/></shape></item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"><shape><solid android:color="@color/px_green"/></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel_pressed"/></shape></item>
            <item android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp"><shape><solid android:color="@color/px_panel_pressed"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="8dp" android:right="8dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#26000000"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:right="4dp"><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_ink"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:left="8dp" android:top="4dp" android:right="8dp" android:gravity="top" android:height="4dp"><shape><solid android:color="#59FFFFFF"/></shape></item>
            <item android:left="8dp" android:right="8dp" android:bottom="4dp" android:gravity="bottom" android:height="4dp"><shape><solid android:color="#26000000"/></shape></item>
        </layer-list>
    </item>
</selector>