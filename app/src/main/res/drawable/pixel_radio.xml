<?xml version="1.0" encoding="utf-8"?>
<!-- ช่องเลือกสี่เหลี่ยมแบบ pixel: ติ๊กแล้วมีสี่เหลี่ยมเล็กอยู่ข้างใน -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel"/></shape></item>
            <item android:top="9dp" android:left="9dp" android:right="9dp" android:bottom="9dp"><shape><solid android:color="@color/px_green"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="@color/px_ink"/><size android:width="28dp" android:height="28dp"/></shape></item>
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp"><shape><solid android:color="@color/px_panel"/></shape></item>
        </layer-list>
    </item>
</selector>